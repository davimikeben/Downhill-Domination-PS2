<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <queries>
        <package android:name="com.armsx2.android" />
        <package android:name="org.armsx2.android" />
        <package android:name="xyz.armsx2.android" />
        <package android:name="xyz.aethersx2.android" />
        <package android:name="xyz.aethersx2.android.pro" />
        <package android:name="com.nethersx2.android" />
        <package android:name="org.nethersx2.android" />
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".DownhillApp"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Downhill">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PadLabActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Downhill.Fullscreen" />

        <activity
            android:name=".legend.LegendActivity"
            android:exported="false"
            android:label="@string/legend_title"
            android:theme="@style/Theme.Downhill" />

        <provider
            android:name=".rom.AppFilesProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
